# Copy this file to server/.env and fill in real values.

# Database — PostgreSQL (production default). For zero-setup local dev
# instead, set provider="sqlite" in prisma/schema.prisma and use
# DATABASE_URL="file:./dev.db".
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL="http://localhost:4000"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# AI — Anthropic Claude. Server-side only, NEVER exposed to the frontend/widget.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# CORS — comma-separated list of origins allowed to call the admin API.
ADMIN_CORS_ORIGIN="http://localhost:5173"

# Widget is embedded on arbitrary third-party sites, so /api/chat and
# /api/widget/config allow any origin by design (tenant isolation is
# enforced by clientId lookup, not by CORS).

# File uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=10
