# Copy this file to server/.env and fill in real values.

PORT=4000
NODE_ENV=development

# There is no AI/LLM in this app -- every answer is either a stored
# knowledge/website article returned verbatim, a database value formatted
# deterministically, or a fixed fallback message. No API key needed.

# Stands in for "the website's real database/API" -- a small JSON file of
# per-website live data (e.g. room availability). Swap for a real
# connection string later without changing the calling code's interface.
DATABASE_URL=./data/live-data.json

# Per-website human handoff phone numbers are NOT set here -- they live in
# server/src/config/websites.ts alongside the rest of each website's
# config (business name, URL, address, hours), since a single global
# HUMAN_PHONE wouldn't let two different local demo websites each have
# their own number.
