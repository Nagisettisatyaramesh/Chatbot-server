{
  "name": "ai-website-assistant",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "admin",
    "widget"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:admin": "npm run dev --workspace=admin",
    "dev:widget": "npm run build --workspace=widget -- --watch",
    "build:widget": "npm run build --workspace=widget",
    "build:admin": "npm run build --workspace=admin",
    "build:server": "npm run build --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server",
    "db:seed": "npm run db:seed --workspace=server"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
